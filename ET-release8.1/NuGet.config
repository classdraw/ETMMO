<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- 覆盖本机 Visual Studio Fallback（常见为已不存在的 E:\VS\Sdk\NuGetPackages），避免 ResolvePackageAssets 失败 -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
